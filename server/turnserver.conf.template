# coturn für ShareToFriends: STUN + TURN-Relay (nur als Fallback, wenn keine direkte Verbindung möglich ist).
listening-port=3478
fingerprint
use-auth-secret
static-auth-secret=__TURN_SECRET__
realm=__DOMAIN__
server-name=__DOMAIN__
total-quota=60
bps-capacity=0
stale-nonce=600
no-cli
no-tls
no-dtls

# Relay-Ports (in der Cloud-Firewall als UDP freigeben)
min-port=49152
max-port=49252

# Das Relay darf nie in interne Netze zeigen (Schutz vor Missbrauch des VPS als Sprungbrett)
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
