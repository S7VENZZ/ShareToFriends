# TLS-Frontend für den Signaling-Dienst. Caddy holt das Zertifikat für {$DOMAIN} automatisch.
{$DOMAIN} {
	encode zstd gzip

	handle /ws {
		reverse_proxy 127.0.0.1:8787
	}

	handle /health {
		reverse_proxy 127.0.0.1:8787
	}

	# App-Updates (electron-updater): ./updates wird vom Dienst updates-sync aus dem neuesten Release befüllt
	handle_path /updates/* {
		root * /srv/updates
		@meta path *.yml *.yaml
		header @meta Cache-Control "no-cache, no-store, must-revalidate"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		respond "ShareToFriends signaling" 200
	}
}
